{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "preview": {
            "node": "22.23.2",
            "distribution": "internal",
            "channel": "preview",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "preview"
            }
        },
        "production": {
            "node": "22.23.2",
            "channel": "production",
            "env": {
                "APP_ENV": "production",
                "MUXR_EAS_PROJECT_ID": "94c02367-50fe-44e0-a6d5-8461a0d06058",
                "MUXR_ANDROID_APPLICATION_ID": "com.trymuxr.app",
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
            }
        },
        "direct": {
            "extends": "production",
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "emulator": {
            "extends": "direct",
            "env": {
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "x86_64"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
