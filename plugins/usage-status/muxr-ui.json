{
  "schemaVersion": 1,
  "pluginId": "muxr.usage-status",
  "minMuxrVersion": 12,
  "contributions": [
    {
      "slot": "host.rpc",
      "id": "usage",
      "type": "rpc",
      "method": "usage",
      "entry": "rpc.mjs"
    },
    {
      "slot": "home.cards",
      "id": "card",
      "type": "native",
      "primitive": "item-list",
      "params": {
        "title": "Usage",
        "icon": "speedometer-outline",
        "accessibilityLabel": "Open coding-agent usage",
        "source": {
          "type": "plugin.call",
          "contributionId": "usage"
        }
      }
    },
    {
      "slot": "session.header.trailing",
      "id": "chip",
      "type": "native",
      "primitive": "item-list",
      "params": {
        "title": "Usage",
        "icon": "speedometer-outline",
        "accessibilityLabel": "Open coding-agent usage",
        "source": {
          "type": "plugin.call",
          "contributionId": "usage"
        }
      }
    }
  ]
}
