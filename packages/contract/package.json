{
    "name": "@trymuxr/contract",
    "version": "0.1.0",
    "description": "muxr wire contract shared by the host and the app",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/umeranjum17/muxr.git",
        "directory": "packages/contract"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./herd": {
            "types": "./dist/herd/index.d.ts",
            "default": "./dist/herd/index.js"
        },
        "./control-plane": {
            "types": "./dist/control-plane/index.d.ts",
            "default": "./dist/control-plane/index.js"
        },
        "./peer": {
            "types": "./dist/peer/index.d.ts",
            "default": "./dist/peer/index.js"
        },
        "./plugins": {
            "types": "./dist/plugins/index.d.ts",
            "default": "./dist/plugins/index.js"
        },
        "./realtime": {
            "types": "./dist/realtime/index.d.ts",
            "default": "./dist/realtime/index.js"
        },
        "./worktree": {
            "types": "./dist/worktree/index.d.ts",
            "default": "./dist/worktree/index.js"
        },
        "./shared": {
            "types": "./dist/shared/index.d.ts",
            "default": "./dist/shared/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --build --force"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@byokit/realtime": "0.2.1"
    }
}
