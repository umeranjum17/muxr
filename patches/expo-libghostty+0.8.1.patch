+// The live screen's active area (never its viewport or scrollback), formatted.
+std::string formatActive(Session* session, GhosttyFormatterFormat emit) {
+  uint16_t cols = 0, rows = 0;
+  ghostty_terminal_get(session->term, GHOSTTY_TERMINAL_DATA_COLS, &cols);
+  ghostty_terminal_get(session->term, GHOSTTY_TERMINAL_DATA_ROWS, &rows);
+  if (cols == 0 || rows == 0) return {};
+  GhosttyPoint from{}, to{};
+  from.tag = to.tag = GHOSTTY_POINT_TAG_ACTIVE;
+  to.value.coordinate.x = cols - 1;
+  to.value.coordinate.y = rows - 1;
