{
  "schemaVersion": 1,
  "pluginId": "muxr.pane-titler",
  "minMuxrVersion": 13,
  "contributions": [
    { "slot": "host.rpc", "id": "agent-name.read", "type": "rpc", "method": "read", "entry": "rpc.mjs", "mode": "read" },
    { "slot": "host.rpc", "id": "agent-name.rename", "type": "rpc", "method": "rename", "entry": "rpc.mjs", "mode": "write" },
    { "slot": "session.header.trailing", "id": "agent-name.open", "type": "screen-button", "title": "Agent Name", "icon": "person-outline", "contentContributionId": "agent-name.screen" },
    {
      "slot": "navigation.content",
      "id": "agent-name.screen",
      "type": "screen",
      "title": "Agent Name",
      "data": { "type": "plugin.call", "contributionId": "agent-name.read" },
      "children": [
        { "type": "text", "text": "This is the real Herdr Agent Name. Rename it anytime; Task Title stays separate.", "tone": "secondary" },
        { "type": "field", "kind": "text", "id": "name", "label": "Agent Name", "placeholder": "falcon", "value": "{{data.agentName}}" },
        { "type": "button", "label": "Rename agent", "action": { "type": "plugin.call", "contributionId": "agent-name.rename" }, "fields": ["name"], "variant": "primary" }
      ]
    }
  ]
}
