{
  "name": "@muxr/demo-studio",
  "private": true,
  "version": "0.0.0",
  "description": "Capture -> cut pipeline for muxr store screenshots and the demo film. Not part of the yarn workspace; install on demand.",
  "type": "module",
  "scripts": {
    "take": "node capture/take.mjs",
    "shots": "node cut/shots.mjs",
    "lockup": "node cut/lockup.mjs",
    "assemble": "node cut/assemble.mjs",
    "sheet": "node review/sheet.mjs",
    "leakcheck": "node review/leakcheck.mjs raw/muxr-demo-1080.mp4",
    "frames": "node frames/render.mjs",
    "all": "node build.mjs"
  },
  "dependencies": {
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
