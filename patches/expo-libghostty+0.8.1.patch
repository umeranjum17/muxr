+// Brings the mirror up to date with the live screen after a write: rows that
+// moved off the live screen's top go into the mirror's scrollback, and the
+// mirror's screen is repainted as the live one. Returns the rows pushed.
+JNIEXPORT jint JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeMirrorSync(
+    JNIEnv*, jobject, jlong liveHandle, jlong mirrorHandle) {
+  auto* live = fromHandle(liveHandle);
+  auto* mirror = fromHandle(mirrorHandle);
+  if (live == nullptr || mirror == nullptr || live->mirrorPaused) return 0;
+  std::vector<std::string> rows = splitRows(formatActive(live, GHOSTTY_FORMATTER_FORMAT_PLAIN));
+  // Plain text leaves trailing blank rows out; compare whole screens.
+  uint16_t screenRows = 0;
+  ghostty_terminal_get(live->term, GHOSTTY_TERMINAL_DATA_ROWS, &screenRows);
+  rows.resize(screenRows);
+  int shift = 0;
+  const bool linedUp = live->mirrorRows.size() == rows.size() &&
+                       screenShift(live->mirrorRows, rows, &shift);
+  // Content that moved down shows rows the mirror already holds (the server
+  // scrolled back, or has not yet come back after a resume): keep comparing
+  // against the newest screen seen until the live edge returns. A screen that
+  // lines up nowhere is a redraw, unless a resume is still settling.
+  if (linedUp && shift < 0) return 0;
+  const int64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+  if (!linedUp && now - live->mirrorResumedAt < kMirrorResumeMs) return 0;
+  live->mirrorResumedAt = 0;
+  // Lined up in place: the footer held. Output that moved the whole area
+  // above it within one frame leaves nothing else in common.
+  const int pushed = !linedUp ? 0 : shift > 0 ? shift : areaMoved(live->mirrorRows, rows);
+  paintMirror(mirror, live, pushed);
+  live->mirrorRows = std::move(rows);
+  return pushed;
+}
+
+// Pauses capture while the server scrolls the pane (its screen then shows old
+// rows), or resumes it. A resume compares against the screen captured last, so
+// output that arrived meanwhile is pushed and nothing is pushed twice.
+JNIEXPORT void JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeMirrorPause(
+    JNIEnv*, jobject, jlong liveHandle, jboolean paused) {
+  auto* live = fromHandle(liveHandle);
+  if (live == nullptr || live->mirrorPaused == static_cast<bool>(paused)) return;
+  live->mirrorPaused = paused;
+  if (!paused) {
+    live->mirrorResumedAt = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+}
+
+// The next snapshot repaints every row (the view switched terminals).
+JNIEXPORT void JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeMarkDirty(JNIEnv*, jobject, jlong handle) {
+  auto* session = fromHandle(handle);
+  if (session != nullptr) markRenderDirtyFull(session);
+}
