+  };
+  while (ghostty_kitty_graphics_placement_next(session->kittyIter)) {
+    uint32_t imageId = 0;
+    int32_t z = 0;
+    uint32_t xOffset = 0;
+    uint32_t yOffset = 0;
+    if (ghostty_kitty_graphics_placement_get(session->kittyIter, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_IMAGE_ID, &imageId) != GHOSTTY_SUCCESS ||
