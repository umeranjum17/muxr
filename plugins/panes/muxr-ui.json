{
  "schemaVersion": 1,
  "pluginId": "muxr.panes",
  "minMuxrVersion": 8,
  "contributions": [
    {
      "slot": "host.rpc",
      "id": "list",
      "type": "rpc",
      "method": "list",
      "entry": "panes.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "tools",
      "type": "rpc",
      "method": "tools",
      "entry": "panes.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "launch",
      "type": "rpc",
      "method": "launch",
      "entry": "panes.mjs",
      "mode": "write"
    },
    {
      "slot": "session.header.trailing",
      "id": "tools-sheet",
      "type": "native",
      "primitive": "item-list",
      "quickAction": true,
      "params": {
        "title": "Applications",
        "icon": "apps-outline",
        "accessibilityLabel": "Applications",
        "source": {
          "type": "plugin.call",
          "contributionId": "tools"
        }
      }
    },
    {
      "slot": "navigation.primary",
      "id": "nav",
      "type": "navigation-item",
      "label": "Shells & tools",
      "icon": "terminal-outline",
      "contentContributionId": "browse"
    },
    {
      "slot": "navigation.content",
      "id": "browse",
      "type": "native",
      "primitive": "item-list",
      "params": {
        "title": "Shells & tools",
        "icon": "terminal-outline",
        "source": {
          "type": "plugin.call",
          "contributionId": "list"
        },
        "refreshIntervalMs": 15000
      }
    }
  ]
}
