+// Returns the OSC 8 hyperlink URI at a viewport cell, or null when the cell
+// has no hyperlink. One grid-ref snapshot per call; interaction-time only.
+JNIEXPORT jstring JNICALL
+Java_expo_modules_libghostty_GhosttyVt_nativeHyperlinkUri(
+    JNIEnv* env, jobject, jlong handle, jint col, jint row) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr || session->term == nullptr) return nullptr;
+  GhosttyGridRef ref{};
+  ref.size = sizeof(ref);
+  if (!viewportGridRef(session, col, row, &ref)) return nullptr;
+  size_t needed = 0;
+  if (ghostty_grid_ref_hyperlink_uri(&ref, nullptr, 0, &needed) != GHOSTTY_OUT_OF_SPACE ||
+      needed == 0) {
+    return nullptr;
+  }
+  // ghostty_grid_ref_hyperlink_uri writes exactly `needed` bytes without a
+  // terminator; keep one spare NUL byte so the decode below can strlen-read.
+  std::vector<uint8_t> uri(needed + 1, 0);
+  size_t written = 0;
+  if (ghostty_grid_ref_hyperlink_uri(&ref, uri.data(), uri.size(), &written) != GHOSTTY_SUCCESS ||
+      written == 0) {
+    return nullptr;
+  }
+  // NewStringUTF requires modified UTF-8, not standard UTF-8: astral
+  // codepoints must arrive as surrogate pairs and embedded NULs as 0xC0 0x80.
+  // 2- and 3-byte sequences are identical in both encodings. Anything that
+  // is not valid UTF-8 fails closed to null.
+  std::string modified;
+  modified.reserve(written * 3 / 2 + 1);
+  for (size_t i = 0; i < written;) {
+    const uint8_t lead = uri[i];
+    if (lead < 0x80) {
+      if (lead == 0) {
+        modified.push_back(static_cast<char>(0xC0));
+        modified.push_back(static_cast<char>(0x80));
+      } else {
+        modified.push_back(static_cast<char>(lead));
+      }
+      i++;
+      continue;
+    }
+    uint32_t cp = 0;
+    size_t len = 0;
+    if ((lead & 0xE0) == 0xC0 && i + 1 < written) {
+      cp = lead & 0x1F;
+      len = 2;
+    } else if ((lead & 0xF0) == 0xE0 && i + 2 < written) {
+      cp = lead & 0x0F;
+      len = 3;
+    } else if ((lead & 0xF8) == 0xF0 && i + 3 < written) {
+      cp = lead & 0x07;
+      len = 4;
+    } else {
+      return nullptr;
+    }
+    for (size_t k = 1; k < len; k++) {
+      if ((uri[i + k] & 0xC0) != 0x80) return nullptr;
+      cp = (cp << 6) | (uri[i + k] & 0x3F);
+    }
+    if ((len == 2 && cp < 0x80) || (len == 3 && cp < 0x800) ||
+        (len == 4 && cp < 0x10000) || (cp >= 0xD800 && cp <= 0xDFFF)) {
+      return nullptr;
+    }
+    if (len == 4) {
+      if (cp > 0x10FFFF) return nullptr;
+      cp -= 0x10000;
+      const uint32_t surrogates[2] = {0xD800 + (cp >> 10), 0xDC00 + (cp & 0x3FF)};
+      for (const uint32_t s : surrogates) {
+        modified.push_back(static_cast<char>(0xE0 | (s >> 12)));
+        modified.push_back(static_cast<char>(0x80 | ((s >> 6) & 0x3F)));
+        modified.push_back(static_cast<char>(0x80 | (s & 0x3F)));
+      }
+    } else {
+      modified.append(reinterpret_cast<const char*>(uri.data() + i), len);
+    }
+    i += len;
+  }
+  return env->NewStringUTF(modified.c_str());
+}
