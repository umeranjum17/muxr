+  selection.size = sizeof(selection);
+  if (ghostty_terminal_grid_ref(session->term, from, &selection.start) != GHOSTTY_SUCCESS ||
+      ghostty_terminal_grid_ref(session->term, to, &selection.end) != GHOSTTY_SUCCESS) {
+    return {};
+  }
+  GhosttyFormatterTerminalOptions opts{};
+  opts.size = sizeof(opts);
+  opts.emit = emit;
+  opts.trim = emit == GHOSTTY_FORMATTER_FORMAT_PLAIN;
+  opts.extra.size = sizeof(opts.extra);
+  opts.extra.screen.size = sizeof(opts.extra.screen);
+  opts.selection = &selection;
+  GhosttyFormatter formatter = nullptr;
+  if (ghostty_formatter_terminal_new(nullptr, &formatter, session->term, opts) != GHOSTTY_SUCCESS) {
+    return {};
+  }
+  uint8_t* out = nullptr;
+  size_t len = 0;
+  std::string text;
+  if (ghostty_formatter_format_alloc(formatter, nullptr, &out, &len) == GHOSTTY_SUCCESS) {
+    text.assign(reinterpret_cast<const char*>(out), len);
+    ghostty_free(nullptr, out, len);
+  }
+  ghostty_formatter_free(formatter);
+  return text;
