{
  "schemaVersion": 1,
  "pluginId": "muxr.status",
  "minMuxrVersion": 14,
  "contributions": [
    {
      "slot": "host.rpc",
      "id": "usage",
      "type": "rpc",
      "method": "usage",
      "entry": "usage.mjs",
      "mode": "read"
    },
    {
      "slot": "session.header.trailing",
      "id": "usage.open",
      "type": "screen-button",
      "title": "Usage",
      "icon": "speedometer-outline",
      "contentContributionId": "usage.details"
    },
    {
      "slot": "navigation.content",
      "id": "usage.details",
      "type": "screen",
      "data": {
        "type": "plugin.call",
        "contributionId": "usage"
      },
      "children": [
        {
          "type": "tabs",
          "path": "data.providers",
          "selectedPath": "data.provider",
          "param": "provider"
        },
        {
          "type": "limits",
          "path": "data.limits",
          "title": "Right now"
        },
        {
          "type": "section",
          "title": "Today",
          "children": [
            {
              "type": "text",
              "text": "{{data.activityNotice}}",
              "tone": "warning"
            },
            {
              "type": "section",
              "columns": 2,
              "children": [
                {
                  "type": "metric",
                  "label": "Tokens",
                  "value": "{{data.todayTokens}}"
                },
                {
                  "type": "metric",
                  "label": "Cost",
                  "value": "{{data.todayCost}}"
                }
              ]
            }
          ]
        },
        {
          "type": "section",
          "title": "Models today",
          "children": [
            {
              "type": "chart",
              "variant": "bar",
              "path": "data.modelSeries",
              "emptyText": "No measured activity today"
            }
          ]
        },
        {
          "type": "section",
          "title": "Last 7 days",
          "children": [
            {
              "type": "section",
              "columns": 2,
              "children": [
                {
                  "type": "metric",
                  "label": "Tokens",
                  "value": "{{data.weekTokens}}"
                },
                {
                  "type": "metric",
                  "label": "Cost",
                  "value": "{{data.weekCost}}"
                }
              ]
            },
            {
              "type": "chart",
              "variant": "column",
              "path": "data.weekSeries",
              "emptyText": "No measured activity this week"
            }
          ]
        },
        {
          "type": "text",
          "text": "Local activity and estimated costs are separate from provider plan limits. Prompts and project details stay out.",
          "tone": "secondary"
        }
      ]
    },
    {
      "slot": "host.rpc",
      "id": "now",
      "type": "rpc",
      "method": "now",
      "entry": "now.mjs",
      "mode": "read"
    },
    {
      "slot": "home.cards",
      "id": "now.card",
      "type": "data-card",
      "title": "Right now",
      "presentation": "card",
      "source": {
        "type": "plugin.call",
        "contributionId": "now"
      },
      "contentContributionId": "usage.details",
      "emptyText": "Usage unavailable"
    },
    {
      "slot": "settings.items",
      "id": "usage.settings",
      "type": "settings-item",
      "label": "Usage",
      "subtitle": "Plan limits, today and this week",
      "icon": "speedometer-outline",
      "action": {
        "type": "screen",
        "contributionId": "usage.details"
      }
    }
  ]
}
