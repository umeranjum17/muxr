{
  "name": "@muxr/wire",
  "version": "0.1.0",
  "private": true,
  "description": "Private shared wire types and schemas for muxr",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "shx rm -rf dist && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "pkgroll": "^2.14.2",
    "shx": "^0.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
