+// Repaints the mirror's screen as the live one, after pushing [pushRows] of its
+// current screen into its scrollback from the bottom margin.
+void paintMirror(Session* mirror, Session* live, int pushRows) {
+  uint16_t rows = 0;
+  ghostty_terminal_get(mirror->term, GHOSTTY_TERMINAL_DATA_ROWS, &rows);
+  std::string out = "\x1b[r";
+  if (pushRows > 0) {
+    out += "\x1b[" + std::to_string(rows) + ";1H";
+    out.append(static_cast<size_t>(pushRows), '\n');
+  }
+  // Erasing below the home position clears without touching scrollback.
+  out += "\x1b[H\x1b[J\x1b[0m";
+  std::string screen = formatActive(live, GHOSTTY_FORMATTER_FORMAT_VT);
+  while (!screen.empty() && (screen.back() == '\n' || screen.back() == '\r')) screen.pop_back();
+  // Every row starts at the left edge, whatever the formatter ends rows with.
+  for (char c : screen) {
+    if (c == '\r') continue;
+    if (c == '\n') out += '\r';
+    out += c;
+  }
+  out += "\x1b[0m\x1b[?25l";
+  ghostty_terminal_vt_write(mirror->term, reinterpret_cast<const uint8_t*>(out.data()), out.size());
+}
