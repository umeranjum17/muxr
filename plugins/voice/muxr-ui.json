{
  "schemaVersion": 1,
  "pluginId": "muxr.voice",
  "minMuxrVersion": 6,
  "capabilities": {
    "voice.status": "status",
    "voice.key.set": "key-set",
    "voice.session": "session",
    "voice.report": "report",
    "voice.provider.list": "provider-list",
    "voice.provider.set": "provider-set",
    "voice.provider.describe": "provider-describe"
  },
  "contributions": [
    {
      "slot": "host.rpc",
      "id": "status",
      "type": "rpc",
      "method": "status",
      "entry": "rpc.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "key-set",
      "type": "rpc",
      "method": "key.set",
      "entry": "rpc.mjs",
      "mode": "write"
    },
    {
      "slot": "host.rpc",
      "id": "key-clear",
      "type": "rpc",
      "method": "key.clear",
      "entry": "rpc.mjs",
      "mode": "write"
    },
    {
      "slot": "host.rpc",
      "id": "provider-list",
      "type": "rpc",
      "method": "provider.list",
      "entry": "rpc.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "provider-set",
      "type": "rpc",
      "method": "provider.set",
      "entry": "rpc.mjs",
      "mode": "write"
    },
    {
      "slot": "host.rpc",
      "id": "provider-describe",
      "type": "rpc",
      "method": "provider.describe",
      "entry": "rpc.mjs",
      "mode": "read"
    },
    {
      "slot": "navigation.content",
      "id": "engines-screen",
      "type": "screen",
      "title": "Voice engines",
      "data": {
        "type": "plugin.call",
        "contributionId": "provider-list"
      },
      "children": [
        {
          "type": "text",
          "text": "Each engine is a different voice on the connected machine. Open one to use it and talk to hear it."
        },
        {
          "type": "list",
          "title": "Engines on this machine",
          "emptyText": "No voice engines are available on this machine.",
          "rows": [],
          "repeat": {
            "path": "data.providers",
            "template": {
              "type": "row",
              "title": "{{item.name}}",
              "subtitle": "{{item.description}}",
              "value": "{{item.stateLabel}}",
              "action": {
                "type": "screen",
                "contributionId": "engine-screen",
                "params": {
                  "providerId": "{{item.id}}"
                }
              }
            }
          }
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "engine-screen",
      "type": "screen",
      "title": "{{data.name}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "provider-describe"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.description}}"
        },
        {
          "type": "row",
          "title": "In use",
          "value": "{{data.selectedLabel}}"
        },
        {
          "type": "row",
          "title": "Setup",
          "value": "{{data.statusLabel}}"
        },
        {
          "type": "button",
          "label": "Use {{data.name}} on this machine",
          "variant": "primary",
          "action": {
            "type": "plugin.call",
            "contributionId": "provider-set"
          }
        },
        {
          "type": "text",
          "text": "Talking starts a live session with the engine in use above."
        },
        {
          "type": "button",
          "label": "Talk now",
          "action": {
            "type": "capability",
            "name": "voice.start"
          }
        }
      ]
    },
    {
      "slot": "host.stream",
      "id": "session",
      "type": "stream",
      "entry": "stream.mjs"
    },
    {
      "slot": "host.rpc",
      "id": "report",
      "type": "rpc",
      "method": "report",
      "entry": "rpc.mjs",
      "mode": "read"
    },
    {
      "slot": "app.overlay",
      "id": "overlay",
      "type": "native",
      "primitive": "realtime-session-overlay"
    },
    {
      "slot": "home.composer.leading",
      "id": "talk-home",
      "type": "native",
      "primitive": "icon-button",
      "params": {
        "capability": "voice.start",
        "icon": "pulse-outline",
        "accessibilityLabel": "Start or open realtime conversation",
        "indicator": "realtime-session"
      }
    },
    {
      "slot": "session.composer.trailing",
      "id": "talk-session",
      "type": "native",
      "primitive": "icon-button",
      "params": {
        "capability": "voice.start",
        "icon": "pulse-outline",
        "accessibilityLabel": "Talk to this session",
        "indicator": "realtime-session"
      }
    },
    {
      "slot": "navigation.content",
      "id": "settings-screen",
      "type": "screen",
      "title": "Realtime voice",
      "data": {
        "type": "plugin.call",
        "contributionId": "status"
      },
      "children": [
        {
          "type": "text",
          "text": "The key is sent directly to the connected machine and is never stored or displayed by the phone."
        },
        {
          "type": "row",
          "title": "Provider",
          "value": "{{data.providerName}}"
        },
        {
          "type": "row",
          "title": "Key",
          "value": "{{data.statusLabel}}"
        },
        {
          "type": "button",
          "label": "Set or replace key",
          "variant": "primary",
          "action": {
            "type": "secure-prompt",
            "title": "Realtime voice API key",
            "message": "Sent once to this machine and stored only there.",
            "inputKey": "key",
            "submit": {
              "type": "plugin.call",
              "contributionId": "key-set"
            }
          }
        },
        {
          "type": "button",
          "label": "Clear key",
          "variant": "danger",
          "action": {
            "type": "confirm",
            "title": "Clear the stored key?",
            "message": "Realtime voice will stop until a new key is configured.",
            "confirmLabel": "Clear",
            "destructive": true,
            "action": {
              "type": "plugin.call",
              "contributionId": "key-clear"
            }
          }
        }
      ]
    },
    {
      "slot": "events",
      "id": "report-when-agent-stops",
      "on": "agent.status",
      "from": "working",
      "to": [
        "idle",
        "done",
        "blocked",
        "failed"
      ],
      "action": {
        "type": "capability",
        "name": "speech.wake",
        "include": "pane"
      }
    },
    {
      "slot": "shortcuts",
      "id": "jarvis",
      "label": "Jarvis",
      "longLabel": "Talk to the muxr realtime agent",
      "synonyms": [
        "Jarvis",
        "voice agent",
        "talk",
        "live voice"
      ],
      "action": {
        "type": "capability",
        "name": "voice.start"
      }
    },
    {
      "slot": "navigation.content",
      "id": "login-screen",
      "type": "screen",
      "title": "Codex Voice setup",
      "data": {
        "type": "plugin.call",
        "contributionId": "status"
      },
      "children": [
        {
          "type": "row",
          "title": "Provider",
          "value": "{{data.providerName}}"
        },
        {
          "type": "row",
          "title": "Login",
          "value": "{{data.statusLabel}}"
        },
        {
          "type": "text",
          "text": "Run codex login with ChatGPT on this machine. No API key needed. Experimental realtime access depends on your account."
        }
      ]
    }
  ]
}
