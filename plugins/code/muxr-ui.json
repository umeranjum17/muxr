{
  "schemaVersion": 1,
  "pluginId": "muxr.code",
  "minMuxrVersion": 11,
  "contributions": [
    {
      "slot": "host.rpc",
      "id": "files.repos",
      "type": "rpc",
      "method": "repos",
      "entry": "files.mjs",
      "mode": "read",
      "context": [
        "sessions"
      ]
    },
    {
      "slot": "host.rpc",
      "id": "files.list",
      "type": "rpc",
      "method": "list",
      "entry": "files.mjs",
      "mode": "read",
      "context": [
        "sessions"
      ]
    },
    {
      "slot": "host.rpc",
      "id": "files.read",
      "type": "rpc",
      "method": "read",
      "entry": "files.mjs",
      "mode": "read",
      "context": [
        "sessions"
      ]
    },
    {
      "slot": "navigation.primary",
      "id": "files.nav",
      "type": "navigation-item",
      "label": "Files",
      "icon": "document-text-outline",
      "contentContributionId": "files.browse"
    },
    {
      "slot": "navigation.content",
      "id": "files.browse",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "files.repos"
      },
      "children": [
        {
          "type": "list",
          "title": "Repositories",
          "emptyText": "No git repositories open",
          "rows": [],
          "repeat": {
            "path": "data.repos",
            "template": {
              "type": "row",
              "title": "{{item.name}}",
              "action": {
                "type": "screen",
                "contributionId": "files",
                "params": {
                  "root": "{{item.root}}"
                }
              }
            }
          }
        }
      ]
    },
    {
      "slot": "session.header.trailing",
      "id": "files.open",
      "type": "screen-button",
      "title": "Files",
      "icon": "folder-outline",
      "contentContributionId": "files"
    },
    {
      "slot": "navigation.content",
      "id": "files",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "files.list"
      },
      "children": [
        {
          "type": "badge",
          "label": "{{data.count}}",
          "tone": "secondary"
        },
        {
          "type": "tree",
          "title": "{{data.title}}",
          "emptyText": "No files",
          "path": "data.tree",
          "source": {
            "type": "plugin.call",
            "contributionId": "files.list"
          },
          "action": {
            "type": "screen",
            "contributionId": "files.file",
            "params": {
              "root": "{{data.root}}",
              "path": "{{item.path}}"
            }
          }
        },
        {
          "type": "text",
          "text": "{{data.treeNote}}",
          "tone": "secondary"
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "files.file",
      "type": "screen",
      "title": "{{data.name}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "files.read"
      },
      "children": [
        {
          "type": "code",
          "path": "data.body",
          "fileNamePath": "data.path"
        },
        {
          "type": "text",
          "text": "{{data.note}}",
          "tone": "secondary"
        }
      ]
    },
    {
      "slot": "host.rpc",
      "id": "changes.list",
      "type": "rpc",
      "method": "list",
      "entry": "changes.mjs",
      "mode": "read"
    },
    {
      "slot": "session.pills",
      "id": "changes",
      "type": "native",
      "primitive": "item-list",
      "params": {
        "title": "Changes",
        "icon": "git-compare-outline",
        "accessibilityLabel": "Open changed files",
        "source": {
          "type": "plugin.call",
          "contributionId": "changes.list"
        }
      }
    },
    {
      "slot": "host.rpc",
      "id": "changes.worktree-list",
      "type": "rpc",
      "method": "worktrees",
      "entry": "changes.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "changes.browse",
      "type": "rpc",
      "method": "browse",
      "entry": "changes.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "changes.patch",
      "type": "rpc",
      "method": "patch",
      "entry": "changes.mjs",
      "mode": "read"
    },
    {
      "slot": "navigation.content",
      "id": "changes.worktrees",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "changes.worktree-list"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.note}}",
          "tone": "secondary"
        },
        {
          "type": "list",
          "rows": [],
          "emptyText": "No registered worktrees",
          "repeat": {
            "path": "data.worktrees",
            "template": {
              "type": "row",
              "title": "{{item.title}}",
              "subtitle": "{{item.subtitle}}",
              "action": {
                "type": "screen",
                "contributionId": "changes.review",
                "params": {
                  "root": "{{item.root}}",
                  "scope": "branch",
                  "sessionId": "{{item.sessionId}}"
                }
              }
            }
          }
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "changes.review",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "changes.browse"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.note}}",
          "tone": "secondary"
        },
        {
          "type": "tabs",
          "path": "data.scopes",
          "selectedPath": "data.scope",
          "param": "scope"
        },
        {
          "type": "list",
          "rows": [],
          "emptyText": "No changes in this comparison",
          "repeat": {
            "path": "data.files",
            "template": {
              "type": "row",
              "title": "{{item.title}}",
              "subtitle": "{{item.subtitle}}",
              "action": {
                "type": "screen",
                "contributionId": "changes.file",
                "params": {
                  "root": "{{item.root}}",
                  "scope": "{{item.scope}}",
                  "path": "{{item.path}}",
                  "kind": "{{item.kind}}",
                  "head": "{{item.head}}",
                  "base": "{{item.base}}",
                  "sessionId": "{{item.sessionId}}"
                }
              }
            }
          }
        },
        {
          "type": "tabs",
          "path": "data.pages",
          "selectedPath": "data.page",
          "param": "page"
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "changes.file",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "changes.patch"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.note}}",
          "tone": "secondary"
        },
        {
          "type": "diff",
          "path": "data.patch"
        }
      ]
    },
    {
      "slot": "host.rpc",
      "id": "history.log",
      "type": "rpc",
      "method": "log",
      "entry": "history.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "history.show",
      "type": "rpc",
      "method": "show",
      "entry": "history.mjs",
      "mode": "read"
    },
    {
      "slot": "session.header.trailing",
      "id": "history.open",
      "type": "screen-button",
      "title": "Git history",
      "icon": "git-branch-outline",
      "contentContributionId": "history.screen"
    },
    {
      "slot": "navigation.content",
      "id": "history.screen",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "history.log"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.count}}",
          "tone": "secondary"
        },
        {
          "type": "list",
          "emptyText": "No commits",
          "rows": [],
          "repeat": {
            "path": "data.commits",
            "template": {
              "type": "row",
              "title": "{{item.subject}}",
              "subtitle": "{{item.meta}}",
              "action": {
                "type": "screen",
                "contributionId": "history.commit",
                "params": {
                  "sha": "{{item.sha}}",
                  "sessionId": "{{item.sessionId}}"
                }
              }
            }
          }
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "history.commit",
      "type": "screen",
      "title": "{{data.subject}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "history.show"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.meta}}",
          "tone": "secondary"
        },
        {
          "type": "diff",
          "path": "data.patch"
        }
      ]
    }
  ]
}
