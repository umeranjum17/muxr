+    JNIEnv* env, jobject, jlong handle) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr) return nullptr;
+  constexpr size_t kMaxKittySnapshotBytes = 64ULL * 1024 * 1024;
+  auto& output = session->kittySnapshot;
+  output.clear();
+  output.resize(4, 0);
+  uint32_t count = 0;
+  GhosttyKittyGraphics graphics = nullptr;
