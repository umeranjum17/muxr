{
  "schemaVersion": 1,
  "pluginId": "muxr.voice",
  "minMuxrVersion": 6,
  "capabilities": {
    "voice.status": "status",
    "voice.session": "session",
    "voice.report": "report"
  },
  "contributions": [
    {
      "slot": "host.rpc",
      "id": "status",
      "type": "rpc",
      "method": "status",
      "entry": "rpc.mjs",
      "mode": "read"
    },
    {
      "slot": "host.stream",
      "id": "session",
      "type": "stream",
      "entry": "stream.mjs"
    },
    {
      "slot": "host.rpc",
      "id": "report",
      "type": "rpc",
      "method": "report",
      "entry": "rpc.mjs",
      "mode": "read"
    },
    {
      "slot": "app.overlay",
      "id": "overlay",
      "type": "native",
      "primitive": "realtime-session-overlay"
    },
    {
      "slot": "home.composer.leading",
      "id": "talk-home",
      "type": "native",
      "primitive": "icon-button",
      "params": {
        "capability": "voice.start",
        "icon": "pulse-outline",
        "accessibilityLabel": "Start or open realtime conversation",
        "indicator": "realtime-session"
      }
    },
    {
      "slot": "session.composer.trailing",
      "id": "talk-session",
      "type": "native",
      "primitive": "icon-button",
      "params": {
        "capability": "voice.start",
        "icon": "pulse-outline",
        "accessibilityLabel": "Talk to this session",
        "indicator": "realtime-session"
      }
    },
    {
      "slot": "events",
      "id": "report-when-agent-stops",
      "on": "agent.status",
      "from": "working",
      "to": [
        "idle",
        "done",
        "blocked",
        "failed"
      ],
      "action": {
        "type": "capability",
        "name": "speech.wake",
        "include": "pane"
      }
    },
    {
      "slot": "shortcuts",
      "id": "jarvis",
      "label": "Jarvis",
      "longLabel": "Talk to the muxr realtime agent",
      "synonyms": [
        "Jarvis",
        "voice agent",
        "talk",
        "live voice"
      ],
      "action": {
        "type": "capability",
        "name": "voice.start"
      }
    }
  ]
}
