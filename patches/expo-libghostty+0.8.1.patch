+// Rows of a whole content area that moved off in one frame: [cur]'s footer
+// (the rows at the bottom that did not change, an agent's prompt box and
+// status) held while the area above it is new output, so no row lines up at a
+// shift. A line wraps on a narrow grid and its tail repeats down the screen, so
+// one stray row can still match in place where the area moved; weigh the rows
+// that changed against the rows that held instead of letting one row veto the
+// move. A frame that shares so little of the area moved it by more than the
+// screen holds, so the whole area is what left. Returns 0 for anything else.
+int areaMoved(const std::vector<std::string>& prev, const std::vector<std::string>& cur) {
+  int top = static_cast<int>(std::min(prev.size(), cur.size()));
+  bool footer = false;
+  for (; top > 0 && prev[top - 1] == cur[top - 1]; top--) footer = footer || !prev[top - 1].empty();
+  if (!footer) return 0;
+  int moved = 0, held = 0;
+  for (int i = 0; i < top; i++) {
+    if (prev[i].empty()) continue;
+    if (prev[i] == cur[i]) held++;
+    else moved++;
+  }
+  return moved > held ? top : 0;
+}
