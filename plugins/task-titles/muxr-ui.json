{
  "schemaVersion": 1,
  "pluginId": "muxr.task-titles",
  "minMuxrVersion": 6,
  "contributions": [
    { "slot": "host.rpc", "id": "status", "type": "rpc", "method": "status", "entry": "rpc.mjs", "mode": "read" },
    { "slot": "host.rpc", "id": "preview", "type": "rpc", "method": "preview", "entry": "rpc.mjs", "mode": "read" },
    { "slot": "host.rpc", "id": "configure", "type": "rpc", "method": "configure", "entry": "rpc.mjs", "mode": "write" },
    { "slot": "host.rpc", "id": "switch", "type": "rpc", "method": "switch", "entry": "rpc.mjs", "mode": "write" },
    { "slot": "host.rpc", "id": "revert", "type": "rpc", "method": "revert", "entry": "rpc.mjs", "mode": "write" },
    {
      "slot": "settings.items", "id": "settings", "type": "settings-item",
      "label": "Task titles", "icon": "text-outline",
      "action": { "type": "screen", "contributionId": "settings-screen" }
    },
    {
      "slot": "navigation.content", "id": "settings-screen", "type": "screen",
      "title": "Task titles",
      "data": { "type": "plugin.call", "contributionId": "status" },
      "children": [
        { "type": "text", "text": "Give each agent task a readable title from its first real prompt. Manual titles always win." },
        { "type": "row", "title": "Title source", "value": "{{data.titleSource}}" },
        { "type": "row", "title": "Update", "value": "{{data.update}}" },
        { "type": "row", "title": "Status", "value": "{{data.status}}" }
      ]
    }
  ]
}
