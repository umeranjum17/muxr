+Java_expo_modules_libghostty_GhosttyVt_nativeKittySnapshot(
+    JNIEnv* env, jobject, jlong handle) {
+  auto* session = fromHandle(handle);
+  if (session == nullptr) return nullptr;
+  std::vector<uint8_t> output(4, 0);
+  uint32_t count = 0;
+  GhosttyKittyGraphics graphics = nullptr;
+  if (ghostty_terminal_get(session->term, GHOSTTY_TERMINAL_DATA_KITTY_GRAPHICS, &graphics) != GHOSTTY_SUCCESS ||
