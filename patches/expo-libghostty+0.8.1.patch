+// How many rows the screen's content moved up from [prev] to [cur]: the shift
+// k at which the most rows read cur[i] == prev[i + k]. Negative is content
+// moving down. A row that appears once on both screens anchors a shift, and
+// the unbroken run of matching rows around it votes with it: on a narrow grid
+// a line wraps, its tail ("stone.", "the rocks.") repeats down the screen, and
+// fast output leaves only one line in common between two frames, so the tails
+// beside it are what make a move of most of the screen visible. A run with no
+// anchor never votes, so repeating text cannot line up at a false shift, and a
+// move counts only rows that changed in place, so a fixed footer, which lines
+// up at 0, cannot outvote a content area that moved most of its height.
+// Returns false when no row lines up at any shift.
+bool screenShift(const std::vector<std::string>& prev, const std::vector<std::string>& cur, int* shift) {
+  const int n = static_cast<int>(std::min(prev.size(), cur.size()));
+  std::unordered_map<std::string, int> seenPrev, seenCur;
+  for (const auto& row : prev) seenPrev[row]++;
+  for (const auto& row : cur) seenCur[row]++;
+  const auto count = [&](int k) {
+    const auto matches = [&](int i) {
+      return !cur[i].empty() && cur[i] == prev[i + k] && (k == 0 || cur[i] != prev[i]);
+    };
+    int matched = 0;
+    for (int i = std::max(0, -k); i < n && i + k < n;) {
+      if (!matches(i)) {
+        i++;
+        continue;
+      }
+      int end = i;
+      bool anchored = false;
+      for (; end < n && end + k < n && matches(end); end++) {
+        anchored = anchored || (seenPrev.at(cur[end]) == 1 && seenCur.at(cur[end]) == 1);
+      }
+      if (anchored) matched += end - i;
+      i = end;
+    }
+    return matched;
+  };
+  int best = 0, bestCount = 0;
+  for (int step = 1; step < n; step++) {
+    for (const int k : {step, -step}) {
+      const int matched = count(k);
+      if (matched > bestCount) {
+        best = k;
+        bestCount = matched;
+      }
+    }
+  }
+  if (bestCount >= 2) {
+    *shift = best;
+    return true;
+  }
+  *shift = 0;
+  return count(0) >= 2;
