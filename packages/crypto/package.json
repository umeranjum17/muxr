{
    "name": "@trymuxr/crypto",
    "version": "0.1.0",
    "description": "muxr end-to-end encryption shared by the host and the app",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/umeranjum17/muxr.git",
        "directory": "packages/crypto"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./e2ee": {
            "types": "./dist/e2ee/index.d.ts",
            "default": "./dist/e2ee/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --build --force"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@byokit/seal": "0.2.0",
        "@trymuxr/contract": "0.1.0"
    }
}
