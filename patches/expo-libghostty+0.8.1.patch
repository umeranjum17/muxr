+  for (size_t i = 0; i < written;) {
+    const uint8_t lead = uri[i];
+    if (lead < 0x80) {
+      if (lead == 0) {
+        modified.push_back(static_cast<char>(0xC0));
+        modified.push_back(static_cast<char>(0x80));
+      } else {
+        modified.push_back(static_cast<char>(lead));
+      }
+      i++;
+      continue;
+    }
