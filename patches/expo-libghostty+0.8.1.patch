+    ghostty_kitty_graphics_placement_get(session->kittyIter, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_X_OFFSET, &xOffset);
+    ghostty_kitty_graphics_placement_get(session->kittyIter, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_Y_OFFSET, &yOffset);
+    const auto image = ghostty_kitty_graphics_image(graphics, imageId);
+    if (image == nullptr) continue;
+    GhosttyKittyGraphicsPlacementRenderInfo info{};
+    info.size = sizeof(info);
+    if (ghostty_kitty_graphics_placement_render_info(session->kittyIter, image, session->term, &info) != GHOSTTY_SUCCESS ||
+        !info.viewport_visible) continue;
+    uint32_t imageWidth = 0;
+    uint32_t imageHeight = 0;
+    GhosttyKittyImageFormat format = GHOSTTY_KITTY_IMAGE_FORMAT_RGBA;
+    const uint8_t* pixels = nullptr;
+    size_t pixelsLength = 0;
+    if (ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_WIDTH, &imageWidth) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_HEIGHT, &imageHeight) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_FORMAT, &format) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_DATA_PTR, &pixels) != GHOSTTY_SUCCESS ||
+        ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_DATA_LEN, &pixelsLength) != GHOSTTY_SUCCESS || pixels == nullptr) continue;
+    const size_t pixelCount = static_cast<size_t>(imageWidth) * imageHeight;
+    if (pixelCount == 0 || pixelCount > 64ULL * 1024 * 1024 / 4) continue;
+    std::vector<uint8_t> rgba(pixelCount * 4);
+    if (format == GHOSTTY_KITTY_IMAGE_FORMAT_RGBA && pixelsLength >= rgba.size()) {
+      memcpy(rgba.data(), pixels, rgba.size());
+    } else if (format == GHOSTTY_KITTY_IMAGE_FORMAT_RGB && pixelsLength >= pixelCount * 3) {
+      for (size_t i = 0; i < pixelCount; i++) {
+        rgba[i * 4] = pixels[i * 3]; rgba[i * 4 + 1] = pixels[i * 3 + 1];
+        rgba[i * 4 + 2] = pixels[i * 3 + 2]; rgba[i * 4 + 3] = 0xFF;
+      }
+    } else continue;
+    appendI32(z); appendI32(info.viewport_col); appendI32(info.viewport_row);
+    appendI32(static_cast<int32_t>(xOffset)); appendI32(static_cast<int32_t>(yOffset));
+    appendI32(static_cast<int32_t>(info.pixel_width)); appendI32(static_cast<int32_t>(info.pixel_height));
+    appendI32(static_cast<int32_t>(info.source_x)); appendI32(static_cast<int32_t>(info.source_y));
+    appendI32(static_cast<int32_t>(info.source_width)); appendI32(static_cast<int32_t>(info.source_height));
+    appendI32(static_cast<int32_t>(imageWidth)); appendI32(static_cast<int32_t>(imageHeight));
+    appendI32(static_cast<int32_t>(rgba.size()));
+    output.insert(output.end(), rgba.begin(), rgba.end());
