{
  "schemaVersion": 1,
  "pluginId": "muxr.code",
  "minMuxrVersion": 11,
  "contributions": [
    {
      "slot": "host.rpc",
      "id": "files.repos",
      "type": "rpc",
      "method": "repos",
      "entry": "files.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "files.list",
      "type": "rpc",
      "method": "list",
      "entry": "files.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "files.read",
      "type": "rpc",
      "method": "read",
      "entry": "files.mjs",
      "mode": "read"
    },
    {
      "slot": "navigation.primary",
      "id": "files.nav",
      "type": "navigation-item",
      "label": "Files",
      "icon": "document-text-outline",
      "contentContributionId": "files.browse"
    },
    {
      "slot": "navigation.content",
      "id": "files.browse",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "files.repos"
      },
      "children": [
        {
          "type": "list",
          "title": "Repositories",
          "emptyText": "No git repositories open",
          "rows": [],
          "repeat": {
            "path": "data.repos",
            "template": {
              "type": "row",
              "title": "{{item.name}}",
              "action": {
                "type": "screen",
                "contributionId": "files",
                "params": {
                  "root": "{{item.root}}"
                }
              }
            }
          }
        }
      ]
    },
    {
      "slot": "session.header.trailing",
      "id": "files.open",
      "type": "screen-button",
      "title": "Files",
      "icon": "folder-outline",
      "contentContributionId": "files"
    },
    {
      "slot": "navigation.content",
      "id": "files",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "files.list"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.count}}",
          "tone": "secondary"
        },
        {
          "type": "tree",
          "title": "Explorer",
          "emptyText": "No files",
          "path": "data.tree",
          "source": {
            "type": "plugin.call",
            "contributionId": "files.list"
          },
          "action": {
            "type": "screen",
            "contributionId": "files.file",
            "params": {
              "root": "{{data.root}}",
              "path": "{{item.path}}"
            }
          }
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "files.file",
      "type": "screen",
      "title": "{{data.name}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "files.read"
      },
      "children": [
        {
          "type": "code",
          "path": "data.body",
          "fileNamePath": "data.name"
        },
        {
          "type": "text",
          "text": "{{data.note}}",
          "tone": "secondary"
        }
      ]
    },
    {
      "slot": "host.rpc",
      "id": "changes.list",
      "type": "rpc",
      "method": "list",
      "entry": "changes.mjs",
      "mode": "read"
    },
    {
      "slot": "session.pills",
      "id": "changes",
      "type": "native",
      "primitive": "item-list",
      "params": {
        "title": "Changes",
        "icon": "git-compare-outline",
        "accessibilityLabel": "Open changed files",
        "source": {
          "type": "plugin.call",
          "contributionId": "changes.list"
        }
      }
    },
    {
      "slot": "host.rpc",
      "id": "history.log",
      "type": "rpc",
      "method": "log",
      "entry": "history.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "history.show",
      "type": "rpc",
      "method": "show",
      "entry": "history.mjs",
      "mode": "read"
    },
    {
      "slot": "session.header.trailing",
      "id": "history.open",
      "type": "screen-button",
      "title": "Git history",
      "icon": "git-branch-outline",
      "contentContributionId": "history.screen"
    },
    {
      "slot": "navigation.content",
      "id": "history.screen",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "history.log"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.count}}",
          "tone": "secondary"
        },
        {
          "type": "list",
          "emptyText": "No commits",
          "rows": [],
          "repeat": {
            "path": "data.commits",
            "template": {
              "type": "row",
              "title": "{{item.subject}}",
              "subtitle": "{{item.meta}}",
              "action": {
                "type": "screen",
                "contributionId": "history.commit",
                "params": {
                  "sha": "{{item.sha}}",
                  "sessionId": "{{item.sessionId}}"
                }
              }
            }
          }
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "history.commit",
      "type": "screen",
      "title": "{{data.subject}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "history.show"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.meta}}",
          "tone": "secondary"
        },
        {
          "type": "diff",
          "path": "data.patch"
        }
      ]
    },
    {
      "slot": "host.rpc",
      "id": "runbook.list",
      "type": "rpc",
      "method": "list",
      "entry": "runbook.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "runbook.detail",
      "type": "rpc",
      "method": "detail",
      "entry": "runbook.mjs",
      "mode": "read"
    },
    {
      "slot": "host.rpc",
      "id": "runbook.run",
      "type": "rpc",
      "method": "run",
      "entry": "runbook.mjs",
      "mode": "write"
    },
    {
      "slot": "navigation.primary",
      "id": "runbook.nav",
      "type": "navigation-item",
      "label": "Runbook",
      "icon": "play-circle-outline",
      "contentContributionId": "runbook.browse"
    },
    {
      "slot": "navigation.content",
      "id": "runbook.browse",
      "type": "screen",
      "title": "{{data.title}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "runbook.list"
      },
      "children": [
        {
          "type": "list",
          "title": "Saved",
          "emptyText": "No commands",
          "rows": [],
          "repeat": {
            "path": "data.items",
            "template": {
              "type": "row",
              "title": "{{item.label}}",
              "subtitle": "{{item.subtitle}}",
              "action": {
                "type": "screen",
                "contributionId": "cmd",
                "params": {
                  "id": "{{item.id}}"
                }
              }
            }
          }
        }
      ]
    },
    {
      "slot": "navigation.content",
      "id": "cmd",
      "type": "screen",
      "title": "{{data.label}}",
      "data": {
        "type": "plugin.call",
        "contributionId": "runbook.detail"
      },
      "children": [
        {
          "type": "text",
          "text": "{{data.run}}",
          "tone": "secondary"
        },
        {
          "type": "field",
          "kind": "text",
          "id": "folder",
          "label": "Run in folder",
          "value": "{{data.cwd}}"
        },
        {
          "type": "tree",
          "title": "Choose folder",
          "emptyText": "No repository folders available",
          "path": "data.folders",
          "selectionField": "folder"
        },
        {
          "type": "button",
          "label": "Run it",
          "action": {
            "type": "plugin.call",
            "contributionId": "runbook.run"
          },
          "fields": [
            "folder"
          ],
          "variant": "primary"
        }
      ]
    }
  ]
}
